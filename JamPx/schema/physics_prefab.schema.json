{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jampx://schema/physics_prefab.schema.json",
  "title": "JamPx Physics Prefab",
  "type": "object",
  "additionalProperties": false,
  "required": [ "version", "templates" ],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "templates": {
      "type": "array",
      "items": { "$ref": "#/$defs/templateDef" }
    }
  },
  "$defs": {
    "vec3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "type": "number" }
    },
    "quat": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "type": "number" }
    },
    "transform": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "p", "q" ],
      "properties": {
        "p": { "$ref": "#/$defs/vec3" },
        "q": { "$ref": "#/$defs/quat" }
      }
    },

    "materialDef": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "static_friction", "dynamic_friction", "restitution" ],
      "properties": {
        "static_friction":  { "type": "number", "default": 0.5 },
        "dynamic_friction": { "type": "number", "default": 0.5 },
        "restitution":      { "type": "number", "default": 0.1 }
      }
    },

    "simFilter": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "word0", "word1", "word2", "word3" ],
      "properties": {
        "word0": { "type": "integer", "minimum": 0 },
        "word1": { "type": "integer", "minimum": 0 },
        "word2": { "type": "integer", "minimum": 0 },
        "word3": { "type": "integer", "minimum": 0 }
      }
    },

    "qryFilter": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "word0", "word1", "word2", "word3" ],
      "properties": {
        "word0": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "word1": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "word2": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "word3": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
      }
    },

    "meshDef": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "mode", "cooked" ],
      "properties": {
        "mode"            : { "type": "string", "enum": [ "single", "merged_scene" ]},
        "cooked"          : { "type": "string" },
        "src"             : { "type": "string" },
        "mesh_index"      : { "type": "integer", "minimum": 0, "default": 0 },
        "primitive_index" : { "type": "integer", "minimum": 0, "default": 0 }
      }
    },

    "shapeDef": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "type", "local_pose", "material", "shape_flag", "sim_filter", "qry_filter" ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [ "box", "sphere", "capsule", "plane", "convex_mesh", "triangle_mesh", "height_field" ]
        },
        "local_pose": { "$ref": "#/$defs/transform" },
        "material"  : { "$ref": "#/$defs/materialDef" },
        "shape_flag": {
          "type": "string",
          "enum": [ "simulation", "simulation_only", "trigger", "trigger_only", "query_only" ]
        },
        "sim_filter"    : { "$ref": "#/$defs/simFilter" },
        "qry_filter"    : { "$ref": "#/$defs/qryFilter" },
        "contact_offset": { "type": "number", "default": 0.0 },
        "rest_offset"   : { "type": "number", "default": 0.02 },

        "half_extents"  : { "$ref": "#/$defs/vec3" },
        "radius"        : { "type": "number" },
        "half_height"   : { "type": "number" },

        "mesh"          : { "$ref": "#/$defs/meshDef" }
      },
      "allOf": [
        { "if": { "properties": { "type": { "const": "box" } } }, "then": { "required": [ "half_extents" ] } },
        { "if": { "properties": { "type": { "const": "sphere" } } }, "then": { "required": [ "radius" ] } },
        { "if": { "properties": { "type": { "const": "capsule" } } }, "then": { "required": [ "radius", "half_height" ] } },
        { "if": { "properties": { "type": { "enum": [ "triangle_mesh", "convex_mesh" ] } } }, "then": { "required": [ "mesh" ] } }
      ]
    },

    "dynBodyDef": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "density", "use_gravity" ],
      "properties": {
        "density"          : { "type": "number",  "default": 1.0 },
        "use_gravity"      : { "type": "boolean", "default": false },
        "linear_damping"   : { "type": "number",  "default": 0.0 },
        "angular_damping"  : { "type": "number",  "default": 0.0 },
        "linear_velocity"  : { "$ref": "#/$defs/vec3" },
        "angular_velocity" : { "$ref": "#/$defs/vec3" }
      }
    },

    "cctMovement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "walk_speed"        : { "type": "number", "default": 5.0 },
        "sprint_speed"      : { "type": "number", "default": 7.5 },
        "crouch_speed"      : { "type": "number", "default": 3.0 },

        "accel_ground"      : { "type": "number", "default": 35.0 },
        "accel_air"         : { "type": "number", "default": 12.0 },
        "friction_ground"   : { "type": "number", "default": 10.0 },
        "gravity"           : { "type": "number", "default": 25.0 },
        "jump_speed"        : { "type": "number", "default": 7.0 },

        "coyote_time_sec"   : { "type": "number", "default": 0.08 },
        "jump_buffer_sec"   : { "type": "number", "default": 0.10 },

        "stand_height"      : { "type": "number", "default": 1.8 },
        "crouch_height"     : { "type": "number", "default": 1.2 },
        "slide_height"      : { "type": "number", "default": 0.6 },
        "radius"            : { "type": "number", "default": 0.35 },  

        "slide_min_speed"   : { "type": "number", "default": 6.0 },
        "slide_duration_sec": { "type": "number", "default": 0.75 },
        "slide_friction"    : { "type": "number", "default": 3.0 },
        "slide_speed_cap"   : { "type": "number", "default": 9.0 }
      }
    },

    "cctDef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "radius"        : { "type": "number" },
        "height"        : { "type": "number" },
        "material"      : { "$ref": "#/$defs/materialDef" },
        "allow_crouch"  : { "type": "boolean" },
        "allow_slide"   : { "type": "boolean" },
        "contact_offset": { "type": "number" },
        "step_offset"   : { "type": "number" },
        "slope_limit"   : { "type": "number" },
        "has_hitbox"    : { "type": "boolean" },
        "movement"      : { "$ref": "#/$defs/cctMovement" }
      }
    },

    "templateDef": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "name", "kind", "spawn_policy", "allow_replication", "shapes" ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [ "static", "dynamic", "kinematic", "character" ]
        },
        "spawn_policy": {
          "type": "string",
          "enum": [ "level_only", "runtime_only", "both" ]
        },
        "allow_replication": {
          "type": "boolean",
          "default": true
        },
        "shapes": {
          "type": "array",
          "items": { "$ref": "#/$defs/shapeDef" }
        },

        "dyn_body": { "$ref": "#/$defs/dynBodyDef" },
        "cct": { "$ref": "#/$defs/cctDef" }
      }
    }
  }
}