{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jampx://schema/physics_prefab_level.schema.json",
  "title": "JamPx Physics Prefab Level",
  "type": "object",
  "additionalProperties": false,
  "required": [ "version", "layers" ],
  "properties": {
    "version": {
      "type": "integer",
      "const": 2
    },
    "scene_name": {
      "type": "string",
      "default": ""
    },
    "layers": {
      "type": "array",
      "items": { "$ref": "#/$defs/layer" }
    }
  },
  "$defs": {
    "vec3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "type": "number" }
    },
    "quat": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "type": "number" }
    },
    "transform": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "p", "q" ],
      "properties": {
        "p": { "$ref": "#/$defs/vec3" },
        "q": { "$ref": "#/$defs/quat" }
      }
    },
    "overrides": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "linear_velocity": { "$ref": "#/$defs/vec3" },
        "angular_velocity": { "$ref": "#/$defs/vec3" },
        "linear_damping": { "type": "number" },
        "angular_damping": { "type": "number" }
      }
    },
    "instance": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "template", "pose" ],
      "properties": {
        "template": {
          "type": "string",
          "minLength": 1
        },
        "pose": { "$ref": "#/$defs/transform" },
        "overrides": { "$ref": "#/$defs/overrides" }
      }
    },
    "layer": {
      "type": "object",
      "additionalProperties": false,
      "required": [ "name", "instances" ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "instances": {
          "type": "array",
          "items": { "$ref": "#/$defs/instance" }
        }
      }
    }
  }
}