{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jam://schema/world_templates.schema.json",
  "title": "Jam World Templates",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "world_templates"],
  "$defs": {
    "nonempty_string": { "type": "string", "minLength": 1 },
    "nonnegative_i32": { "type": "integer", "x-jam-scalar": "i32", "minimum": 0 },
    "world_template": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "group",
        "allow_multiple_instance_per_user",
        "persistent",
        "destroy_when_empty",
        "is_private",
        "capacity"
      ],
      "properties": {
        "group": { "$ref": "#/$defs/nonnegative_i32" },
        "allow_multiple_instance_per_user": { "type": "boolean" },
        "persistent": { "type": "boolean" },
        "destroy_when_empty": { "type": "boolean" },
        "is_private": { "type": "boolean" },
        "capacity": { "$ref": "#/$defs/nonnegative_i32" }
      }
    }
  },
  "properties": {
    "version": { "type": "integer", "x-jam-scalar": "i32" },
    "world_templates": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/nonempty_string"
      },
      "additionalProperties": {
        "$ref": "#/$defs/world_template"
      }
    }
  }
}
