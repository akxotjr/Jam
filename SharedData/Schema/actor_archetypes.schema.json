{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jam://schema/actor_archetypes.schema.json",
  "title": "Jam Actor Archetypes",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "archetypes"],
  "$defs": {
    "nonempty_string": { "type": "string", "minLength": 1 },
    "spawn_policy": {
      "type": "string",
      "enum": ["level_only", "runtime_only", "both"]
    },
    "actor_archetype": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spawn_policy", "allow_replication"],
      "properties": {
        "physics_archetype": {
          "$ref": "#/$defs/nonempty_string",
          "description": "Authoring reference string to the physics actor archetype name."
        },
        "spawn_policy": {
          "$ref": "#/$defs/spawn_policy",
          "description": "Allowed creation source for this logical actor archetype."
        },
        "allow_replication": {
          "type": "boolean",
          "description": "Whether instances of this logical actor archetype may participate in replication."
        }
      }
    }
  },
  "properties": {
    "version": { "type": "integer", "x-jam-scalar": "i32" },
    "archetypes": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/nonempty_string"
      },
      "additionalProperties": {
        "$ref": "#/$defs/actor_archetype"
      }
    }
  }
}
