{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jam://schema/actor_archetypes.schema.json",
  "title": "Jam Actor Archetypes",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "archetypes"],
  "$defs": {
    "u64": { "type": "integer", "x-jam-scalar": "u64", "minimum": 0, "maximum": 18446744073709551615 },
    "nonempty_string": { "type": "string", "minLength": 1 },
    "nonzero_u64": { "type": "integer", "x-jam-scalar": "u64", "minimum": 1, "maximum": 18446744073709551615 },
    "actor_archetype": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "archetype_key"
      ],
      "properties": {
        "archetype_key": { "$ref": "#/$defs/nonzero_u64" },
        "physics_archetype": {
          "$ref": "#/$defs/nonempty_string",
          "description": "Authoring reference string to the physics actor archetype name."
        },
        "physics_archetype_key": {
          "$ref": "#/$defs/u64",
          "description": "Runtime key for the referenced physics actor archetype."
        }
      }
    }
  },
  "properties": {
    "version": { "type": "integer", "x-jam-scalar": "i32" },
    "archetypes": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/nonempty_string"
      },
      "additionalProperties": {
        "$ref": "#/$defs/actor_archetype"
      }
    }
  }
}
