{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jam://schema/world_archetypes.schema.json",
  "title": "Jam World Archetypes",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "world_archetypes"],
  "$defs": {
    "nonempty_string": { "type": "string", "minLength": 1 },
    "world_archetype": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "template_name"
      ],
      "properties": {
        "template_name": {
          "$ref": "#/$defs/nonempty_string",
          "description": "Authoring reference string to the canonical world template name."
        },
        "actor_level_name": {
          "$ref": "#/$defs/nonempty_string",
          "description": "Canonical level-content lookup key into shared_data_manifest.content.actor_level_set. Resolves the ActorLevelAsset document."
        },
        "physics_asset_name": {
          "$ref": "#/$defs/nonempty_string",
          "description": "Lookup key into shared_data_manifest.content.physics_asset_set. Resolves the PhysicsAsset document used as spawn backend."
        }
      }
    }
  },
  "properties": {
    "version": { "type": "integer", "x-jam-scalar": "i32" },
    "world_archetypes": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/nonempty_string"
      },
      "additionalProperties": {
        "$ref": "#/$defs/world_archetype"
      }
    }
  }
}
