{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jam://schema/M1/world_contents.schema.json",
  "title": "M1 World Contents",
  "description": "M1-specific authored content used to materialize players and configure portals for each world archetype.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "worlds", "instances"],
  "$defs": {
    "nonempty_string": {
      "type": "string",
      "minLength": 1
    },
    "vec3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "number",
        "x-jam-scalar": "f32"
      }
    },
    "vec2": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "number",
        "x-jam-scalar": "f32"
      }
    },
    "quat": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "number",
        "x-jam-scalar": "f32"
      }
    },
    "spawn_pose": {
      "type": "object",
      "additionalProperties": false,
      "required": ["p", "q"],
      "properties": {
        "p": {
          "$ref": "#/$defs/vec3"
        },
        "q": {
          "$ref": "#/$defs/quat"
        }
      }
    },
    "destination_selector": {
      "type": "string",
      "enum": [
        "default_for_archetype",
        "explicit_instance",
        "authored_destination"
      ]
    },
    "portal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "actor_id",
        "approach_position",
        "arrival_spawn"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/nonempty_string",
          "description": "Stable logical portal name used by instance-specific route definitions."
        },
        "actor_id": {
          "type": "integer",
          "x-jam-scalar": "u32",
          "minimum": 1048577,
          "maximum": 2097151,
          "description": "Stable authored ActorId of the portal actor in the source actor level."
        },
        "approach_position": {
          "$ref": "#/$defs/vec3",
          "description": "Server-authoritative movement target used by headless clients to enter this portal."
        },
        "arrival_spawn": {
          "$ref": "#/$defs/nonempty_string",
          "description": "Player spawn key resolved from the target world's player_spawns map."
        }
      }
    },
    "portal_destination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["world_archetype", "destination_name"],
      "properties": {
        "world_archetype": {
          "$ref": "#/$defs/nonempty_string"
        },
        "destination_name": {
          "$ref": "#/$defs/nonempty_string"
        }
      }
    },
    "instance_content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["world_archetype", "portal_destinations"],
      "properties": {
        "world_archetype": {
          "$ref": "#/$defs/nonempty_string"
        },
        "portal_destinations": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/nonempty_string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/portal_destination"
          }
        }
      }
    },
    "traverse_lane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "direction", "length"],
      "properties": {
        "start": {
          "$ref": "#/$defs/vec3"
        },
        "direction": {
          "$ref": "#/$defs/vec2"
        },
        "length": {
          "type": "number",
          "x-jam-scalar": "f32",
          "exclusiveMinimum": 0
        }
      }
    },
    "hotspot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["center", "half_extents"],
      "properties": {
        "center": {
          "$ref": "#/$defs/vec3"
        },
        "half_extents": {
          "$ref": "#/$defs/vec2"
        }
      }
    },
    "scenario_layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["traverse_lanes", "hotspots"],
      "properties": {
        "traverse_lanes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/traverse_lane"
          }
        },
        "hotspots": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/hotspot"
          }
        }
      }
    },
    "world_contents": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "player_actor_archetype",
        "default_player_spawn",
        "player_spawns",
        "portals",
        "scenario"
      ],
      "properties": {
        "player_actor_archetype": {
          "$ref": "#/$defs/nonempty_string",
          "description": "Runtime actor archetype used to materialize a controlled player in this world."
        },
        "default_player_spawn": {
          "$ref": "#/$defs/nonempty_string",
          "description": "Spawn key used for an initial entry without an explicit arrival spawn."
        },
        "player_spawns": {
          "type": "object",
          "description": "Named server-authoritative player arrival poses.",
          "propertyNames": {
            "$ref": "#/$defs/nonempty_string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/spawn_pose"
          }
        },
        "portals": {
          "type": "array",
          "description": "Portal definitions whose actor ids belong to this world's actor level.",
          "items": {
            "$ref": "#/$defs/portal"
          }
        },
        "scenario": {
          "$ref": "#/$defs/scenario_layout"
        }
      }
    }
  },
  "properties": {
    "version": {
      "type": "integer",
      "x-jam-scalar": "i32",
      "const": 1
    },
    "worlds": {
      "type": "object",
      "description": "M1 content indexed by canonical world archetype name.",
      "propertyNames": {
        "$ref": "#/$defs/nonempty_string"
      },
      "additionalProperties": {
        "$ref": "#/$defs/world_contents"
      }
    },
    "instances": {
      "type": "object",
      "description": "Instance-specific topology for worlds sharing the same archetype content.",
      "propertyNames": {
        "$ref": "#/$defs/nonempty_string"
      },
      "additionalProperties": {
        "$ref": "#/$defs/instance_content"
      }
    }
  }
}
