namespace jam.net.fb;


table fbGameInput
{
	user_id				: ulong;
	sequence			: uint;
	flags				: uint;
	command_epoch		: uint;
	yaw					: float;
	pitch				: float;
	move_mode			: ubyte;
	mouse_move_kind		: ubyte;
	target_x			: float;
	target_y			: float;
	target_z			: float;
	target_net_id		: uint;
}

root_type fbGameInput;
file_identifier "INPT";
