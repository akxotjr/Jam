namespace jam.net.fb;



struct fbTransformDelta
{
	data0				: ulong;
	data1				: ulong;
}

struct fbTransformFull
{
	data0				: ulong;
	data1				: ulong;
	data2				: ulong;
}

struct fbCharacterFull128
{
	data0 : ulong;
	data1 : ulong;
}

struct fbCharacterFull160
{
	data0 : uint;
	data1 : uint;
	data2 : uint;
	data3 : uint;
	data4 : uint;
}

struct fbCharacterDelta96
{
	data0 : uint;
	data1 : uint;
	data2 : uint;
}

struct fbCharacterDelta128
{
	data0 : ulong;
	data1 : ulong;
}

struct fbKinematicState
{
	start_epoch : ulong;
	phase		: uint;
	t			: float;
	target_id	: uint;
	event_mask	: uint;
	kine_type	: ubyte;
}


// --- Snapshot --- 

table fbSnapshotHeader
{
	server_tick			: uint;
	input_ack			: uint;
	input_epoch			: uint;
	global_keyframe		: bool = false;
}


table fbActorEntity
{
	actor_id			: uint;
	baseline_rev		: uint;

	transform_full		: fbTransformFull;
	transform_delta		: fbTransformDelta;

	character_full		: fbCharacterFull160;
	character_delta		: fbCharacterDelta128;

	kinematic_state		: fbKinematicState;
}

table fbSnapshot
{
	world_id			: ulong;
	header				: fbSnapshotHeader;
	entities			: [fbActorEntity];
}

root_type fbSnapshot;
file_identifier "SNAP";
