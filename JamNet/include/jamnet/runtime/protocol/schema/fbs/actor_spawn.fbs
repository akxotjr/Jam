include "physics_type.fbs";
include "snapshot.fbs";

namespace jam.net.fb;



// UDP: 일반 actor 생성. 소유자는 인증된 요청자로 결정하며 control은 부여하지 않는다.
table fbSpawnActorReq
{
	world_id				: ulong;
	world_instance_id		: ulong;
	client_request_id		: uint;

	actor_archetype_key		: ulong;
	pos						: fbVec3;
	rot						: fbQuat;
	spawn_src				: uint;		// 0 : level, 1: runtime, 2: network, 3: tool
	override_mask 			: uint;		// bitmask for override fields below
	linear_vel				: fbVec3;
	angular_vel				: fbVec3;
	linear_damping			: float;
	angular_damping			: float;
	yaw						: float;
	pitch					: float;

	target_actor_id			: uint;
}

enum fbSpawnActorResult : byte
{
	Succeeded,
	InvalidCorrelation,
	StaleRevision,
	AlreadySpawned,
	SpawnFailed,
	InvalidArgument,
	Rejected
}

table fbSpawnActorRes
{
	result					: fbSpawnActorResult;
	client_request_id		: uint;
	actor_id				: uint;
}

// TCP: Main 적용 상태를 증명한 user의 player 생성만 허용한다.
table fbSpawnPlayerReq
{
	world_id				: ulong;
	world_instance_id		: ulong;
	expected_main_revision	: ulong;
	client_request_id		: uint;
	actor_archetype_key		: ulong;
	pos						: fbVec3;
	rot						: fbQuat;
	spawn_src					: uint;
	override_mask 				: uint;
	linear_vel					: fbVec3;
	angular_vel					: fbVec3;
	linear_damping				: float;
	angular_damping				: float;
	yaw						: float;
	pitch						: float;
	target_actor_id				: uint;
}

enum fbSpawnPlayerFailure : byte
{
	None,
	InvalidCorrelation,
	StaleRevision,
	AlreadySpawned,
	SpawnFailed
}

table fbSpawnPlayerRes
{
	success				: bool;
	failure				: fbSpawnPlayerFailure;
	client_request_id	: uint;
	actor_id				: uint;
}

table fbDespawnActorReq
{
	world_id			: ulong;
	world_instance_id	: ulong;
	actor_id				: uint;
}

table fbDespawnActorRes
{
	success				: bool;
}

// TCP: player 소유권과 Main revision을 검증한 뒤 controlled player를 제거한다.
table fbDespawnPlayerReq
{
	world_id				: ulong;
	world_instance_id		: ulong;
	expected_main_revision	: ulong;
	actor_id					: uint;
}

table fbDespawnPlayerRes
{
	success				: bool;
}

root_type fbSpawnPlayerReq;
file_identifier "SPLY";
