namespace jam.net.fb;

enum fbSocialAudience : ubyte
{
	Direct = 0,
	Group,
	Global
}

enum fbSocialRecipientKind : ubyte
{
	None = 0,
	AccountId,
	CharacterId,
	CharacterName
}

table fbSocialRecipient
{
	kind : fbSocialRecipientKind = None;
	id   : ulong;
	name : string;
}

table fbSocialAddress
{
	audience : fbSocialAudience;
	scope_id : ulong;
	recipient : fbSocialRecipient;
}
