namespace jam.net.fb;

enum fbLifecycleOp : ubyte
{
	Created    = 0,
	AoiEntered = 1,
	AoiLeft    = 2,
	Destroyed  = 3
}

table fbActorMeta
{
	owned				: bool		= false;
	controlled			: bool		= false;
	actor_archetype_key	: ulong		= 0;
	body_type			: ubyte		= 0;
}

table fbLifecycleActor
{
	op				: fbLifecycleOp = Created;
	actor_id		: uint;
	meta			: fbActorMeta; // Present only for Created; immutable until Destroyed.
}

table fbLifecycleBatch
{
	world_id		: ulong;
	server_tick		: uint;
	actors			: [fbLifecycleActor];
}

root_type fbLifecycleBatch;
file_identifier "LIFE";
