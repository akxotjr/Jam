namespace jam.net.fb;

table fbTcpBindReq
{
	account_id	: ulong;
}

table fbTcpBindRes
{
	success		: bool;
	account_id	: ulong;
	user_id		: ulong;
}

table fbUdpBindReq
{
	account_id	: ulong;
	user_id		: ulong;
}

table fbUdpBindRes
{
	success		: bool;
	account_id	: ulong;
	user_id		: ulong;
}

root_type fbTcpBindReq;
file_identifier "BIND";